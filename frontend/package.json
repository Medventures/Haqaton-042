{
  "name": "medrep-consultation-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src package.json index.html README.md vite.config.ts",
    "format:check": "prettier --check src package.json index.html README.md vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "fflate": "^0.8.2",
